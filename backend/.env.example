PORT=5000
NODE_ENV=production

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/devi-ji?retryWrites=true&w=majority

# JWT Secret for Admin and Member Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Master Admin Credentials
ADMIN_USERNAME=developermanikdas
ADMIN_PASSWORD=your_secure_admin_password

# Groq API Key for RAG Personal Archive Chatbot
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Cloudinary Storage for Story / Resource Uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Production Client URL for CORS Whitelisting
# Example: https://my-archive-site.vercel.app
CLIENT_URL=https://your-frontend-domain.com

# Admin Email Alerts (Optional SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
ADMIN_NOTIFICATION_EMAIL=
